# GEMINI_API_KEY: Required for Gemini AI API calls (Assistant V-Micro & Multimodal KYC tests).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security & Transport (Server-side only)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS"
WEBHOOK_HMAC_SECRET="CHANGE_ME_WEBHOOK_HMAC_SECRET"
FORCE_HTTPS="false"
VMICRO_REQUIRE_HTTPS="false"

# Database (PostgreSQL for Spring Boot / SQLite fallback in AI Studio Node runtime)
DATABASE_URL="postgresql://vmicro:vmicro_local_dev@localhost:5432/vmicro_credit"
SQLITE_DB_PATH="./vmicro_credit.db"

# Android Expo & Decoupled Web Client API URL (HTTPS obligatoire en production)
EXPO_PUBLIC_API_URL="https://votre-api-https.exemple.cd"
VITE_API_BASE_URL=""
VMICRO_CORS_ORIGINS="*"
VMICRO_SEED_DEMO_CLIENTS="true"

# Simulation & Regulatory Flags
PAYMENT_MODE="SIMULATION"
HALISI_MODE="MOCK"
MIN_ELIGIBLE_AGE="18"
